{
  "name": "easonchang.com-next",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@giscus/react": "^3.1.0",
    "@heroicons/react": "^2.0.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "feed": "^6.0.0",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-wrap-balancer": "^1.1.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "postcss": "^8.5.25",
      "sharp": "^0.35.3",
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-themes": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "chromatic": "^18.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.4.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
